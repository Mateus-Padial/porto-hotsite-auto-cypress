# Ambiente alvo do Cypress: dev | hml | prd
# Carrega o arquivo .env.<CYPRESS_ENV> correspondente.
CYPRESS_ENV=hml

# URL base da API do hotsite (usada nas requisicoes de autenticacao/SSO)
base_url=http://localhost

# Token Bearer para obter o accessToken (SEGREDO — nao versionar)
auth_token=coloque_o_token_aqui

# Chave de subscription da APIM para o endpoint de token (SEGREDO)
subscription_key=coloque_a_subscription_key_aqui

# CPF do usuario de teste (DADO PESSOAL — usar massa de teste, nunca CPF real de cliente)
cpf=00000000000

# Chave de subscription da APIM para o endpoint de SSO (SEGREDO)
key_sso=coloque_a_key_sso_aqui

# URL do hotsite Meu Porto (navegacao no browser)
meu_porto_url=http://localhost/

# Chave de gravacao do Cypress Cloud (SEGREDO — opcional, apenas para --record)
CYPRESS_RECORD_KEY=

# Habilita logs de depuracao adicionais (true para ligar)
DEBUG=false
